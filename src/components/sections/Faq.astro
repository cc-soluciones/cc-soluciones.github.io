---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";

import { faqs } from "@/data/faq";
import { store } from "@/lib/store";
import { t } from "@/lib/i18n";
import type { Lang } from "@/data/i18n";

const currentLang: Lang = store.getLang();
const sectionId: string = "faq";
---

<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((_, i) => ({
        "@type": "Question",
        "name": t(currentLang, `faq.${i}.q`),
        "acceptedAnswer": {
            "@type": "Answer",
            "text": t(currentLang, `faq.${i}.a`),
        },
    })),
})} />

<Section
    id={sectionId}
    title={t(currentLang, "faq.title")}
    titleHighlight={t(currentLang, "faq.titleHighlight")}
    badgeIcon="mdi:help-circle-outline"
    badge={t(currentLang, "faq.badge")}
    description={t(currentLang, "faq.description")}
>
    <div class="mx-auto max-w-3xl space-y-4" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((_, i) => (
            <details
                class="relative rounded-3xl border border-border bg-foreground/5 shadow-2xl open:bg-foreground/8 group"
                itemscope
                itemprop="mainEntity"
                itemtype="https://schema.org/Question"
            >
                <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none text-foreground hover:text-primary transition-colors [&::-webkit-details-marker]:hidden [&::marker]:hidden">
                    <Title size="sm" itemprop="name">{t(currentLang, `faq.${i}.q`)}</Title>
                    <Icon name="mdi:chevron-down" class="size-6 text-primary group-open:rotate-180 transition-transform duration-300" />
                </summary>
                <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
                    <Text class="px-5 pb-5" itemprop="text">{t(currentLang, `faq.${i}.a`)}</Text>
                </div>
            </details>
        ))}
    </div>
</Section>
