---
import Section from "@/components/ui/Section.astro";
import Card from "@/components/ui/Card.astro";
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Carrousel from "@/components/ui/Carrousel.astro";

import { projects } from "@/data/projects";
import { t } from "@/lib/i18n";
import { store } from "@/lib/store";
import type { Lang } from "@/data/i18n";

const currentLang: Lang = store.getLang() === "es" ? "en" : "es";
const sectionId: string = "projects";
---

<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": t(currentLang, "projects.title") + " " + t(currentLang, "projects.titleHighlight"),
    "description": t(currentLang, "projects.description"),
    "itemListElement": projects.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
            "@type": "CreativeWork",
            "name": t(currentLang, `projects.item${i}.title`),
            "description": t(currentLang, `projects.item${i}.desc`),
            "url": p.url,
        },
    })),
})} />

<Section
    id={sectionId}
    title={t(currentLang, "projects.title")}
    titleHighlight={t(currentLang, "projects.titleHighlight")}
    badgeIcon="mdi:hexagon-multiple"
    badge={t(currentLang, "projects.badge")}
    description={t(currentLang, "projects.description")}
>
    <Carrousel>
        {projects.map((project, i) => (
            <div class="embla__slide" itemscope itemtype="https://schema.org/CreativeWork">
                <Card class="p-0! h-150 flex flex-col-reverse shadow-none">
                    <img
                        src={project.images[0].src}
                        alt={t(currentLang, `projects.item${i}.title`)}
                        class="h-150 w-full absolute -z-10"
                    />
                    <div class="absolute inset-0 bg-background/50 backdrop-blur-lg mask-[linear-gradient(to_bottom,transparent_35%,black_60%)]" />
                    <div class="relative z-10 p-6 sm:p-8 h-85">
                        <meta itemprop="name" content={t(currentLang, `projects.item${i}.title`)} />
                        <meta itemprop="description" content={t(currentLang, `projects.item${i}.desc`)} />
                        <meta itemprop="url" content={project.url} />
                        <Badge class="w-auto">{t(currentLang, "projects.type")}</Badge>
                        <Title size="sm" class="py-2">{t(currentLang, `projects.item${i}.title`)}</Title>
                        <Text class="h-40">{t(currentLang, `projects.item${i}.desc`)}</Text>
                        <Button
                            href={project.url}
                            variant="primary"
                            size="md"
                            icon="mdi:link"
                            class="w-full"
                        >
                            {t(currentLang, "projects.viewProject")}
                        </Button>
                    </div>
                </Card>
            </div>
        ))}
    </Carrousel>
</Section>
