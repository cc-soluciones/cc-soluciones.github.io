---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";

import { contactInfo, contactFeatures } from "@/data/contact";
import { store } from "@/lib/store";
import { t } from "@/lib/i18n";
import type { Lang } from "@/data/i18n";

const currentLang: Lang = store.getLang();
const sectionId: string = "contact";
const whatsappNumber = contactInfo.phone;
---

<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": t(currentLang, "contact.title") + " " + t(currentLang, "contact.titleHighlight"),
    "description": t(currentLang, "contact.description"),
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": `+${whatsappNumber}`,
        "contactType": "sales",
        "email": contactInfo.email,
        "availableLanguage": ["Spanish", "English"],
    },
})} />

<Section
    id={sectionId}
    title={t(currentLang, "contact.title")}
    titleHighlight={t(currentLang, "contact.titleHighlight")}
    badgeIcon="mdi:chat-question"
    badge={t(currentLang, "contact.badge")}
    description={t(currentLang, "contact.description")}
>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-stretch" itemscope itemtype="https://schema.org/ContactPage">
        <meta itemprop="description" content={t(currentLang, "contact.description")} />

        <div class="lg:col-span-2 flex flex-col gap-4">
            <Card class="flex flex-col items-center text-center gap-1" padding="lg">
                <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
                    <Icon name="mdi:whatsapp" class="w-7 h-7 text-primary" />
                </div>
                <Title size="xs">{t(currentLang, "contact.whatsapp")}</Title>
                <Text size="sm">{contactInfo.phone}</Text>
                <Button href={contactInfo.whatsappLink} variant="outline" size="sm" icon="mdi:open-in-new" class="w-full">
                    {t(currentLang, "contact.whatsapp")}
                </Button>
            </Card>

            <Card class="flex flex-col items-center text-center gap-1" padding="lg">
                <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
                    <Icon name="mdi:email" class="w-7 h-7 text-primary" />
                </div>
                <Title size="xs">{t(currentLang, "contact.email")}</Title>
                <Text size="sm">{contactInfo.email}</Text>
                <Button href={`mailto:${contactInfo.email}`} variant="outline" size="sm" icon="mdi:open-in-new" class="w-full">
                    {t(currentLang, "contact.whatsapp")}
                </Button>
            </Card>

            <div class="grid grid-cols-2 gap-3 flex-1">
                {contactFeatures.map((feature) => (
                    <Card padding="sm" glow={false} class="flex flex-col items-center text-center gap-2 justify-center">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                            <Icon name={feature.icon} class="w-5 h-5 text-primary" />
                        </div>
                        <Title size="sm" class="text-xs!">{feature.title}</Title>
                        <Text size="sm" class="text-xs!">{feature.description}</Text>
                    </Card>
                ))}
            </div>
        </div>

        <div class="lg:col-span-3">
            <Card padding="lg" class="h-full!">
                <form id="contact-form" class="space-y-6 h-full flex flex-col">
                    <div class="flex-1 space-y-6">
                    <Input name="name" type="text" label={t(currentLang, "contact.form.name")} placeholder={t(currentLang, "contact.form.name")} required />
                    <Input name="email" type="email" label={t(currentLang, "contact.form.email")} placeholder={t(currentLang, "contact.form.email")} required />
                    <Input name="phone" type="tel" label={t(currentLang, "contact.form.phone")} placeholder={t(currentLang, "contact.form.phone")} />
                    <Input name="message" type="textarea" label={t(currentLang, "contact.form.message")} placeholder={t(currentLang, "contact.form.message")} required rows={8} />
                    </div>
                    <Button type="submit" variant="primary" size="lg" icon="mdi:whatsapp" class="w-full">
                        {t(currentLang, "contact.form.submit")}
                    </Button>
                    <Text size="sm" class="text-center!">
                        {t(currentLang, "contact.form.responseTime")}
                    </Text>
                </form>
            </Card>
        </div>
    </div>
</Section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (form) {
        form.addEventListener("submit", (e) => {
            e.preventDefault();
            const data = new FormData(form);
            const name = data.get("name")?.toString().trim() || "";
            const email = data.get("email")?.toString().trim() || "";
            const phone = data.get("phone")?.toString().trim() || "";
            const message = data.get("message")?.toString().trim() || "";

            const lines = [
                `Hola CC Soluciones`,
                ``,
                `*Nombre:* ${name}`,
                `*Email:* ${email}`,
            ];
            if (phone) lines.push(`*Teléfono:* ${phone}`);
            lines.push(``);
            lines.push(`*Mensaje:*`);
            lines.push(message);

            const text = encodeURIComponent(lines.join("\n"));
            window.open(`https://wa.me/${"56927240093"}?text=${text}`, "_blank");
        });
    }
</script>
