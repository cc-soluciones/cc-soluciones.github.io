---
import { Icon } from "astro-icon/components";

import Section from "@/components/ui/Section.astro";
import Title from "@/components/ui/Title.astro";
import Text from "@/components/ui/Text.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";

import { workflowSteps } from "@/data/workflow";
import { t } from "@/lib/i18n";
import type { Lang } from "@/data/i18n";

const currentLang: Lang = "es";
const sectionId: string = "workflow";
---

<Section id={sectionId}>
    <div class="flex flex-col gap-4 mb-16 items-center text-center">
        <Badge icon="mdi:timeline-clock">
            {t(currentLang, "workflow.badge")}
        </Badge>
        <Title as="h2" highlight={t(currentLang, "workflow.titleHighlight")}>
            {t(currentLang, "workflow.title")}
        </Title>
        <Text size="lg" class="max-w-xl">
            {t(currentLang, "workflow.description")}
        </Text>
    </div>

    <div class="relative" data-workflow>
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 -translate-x-1/2 bg-linear-to-b from-primary/10 via-primary/40 to-primary/10" />

        {workflowSteps.map((step, index) => {
            const isLeft = index % 2 === 0;
            return (
                <div
                    class={`relative flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-8 mb-12 md:mb-16 last:mb-0 workflow-step cursor-pointer ${isLeft ? "" : "md:flex-row-reverse"}`}
                    data-index={index}
                >
                    <div class={`flex-1 ${isLeft ? "md:text-right md:pr-8" : "md:text-left md:pl-8"}`}>
                        <Card class={`flex flex-nowrap items-center gap-4 ${isLeft ? "md:rounded-s-full md:flex-row-reverse" : "md:rounded-e-full"}`} padding="md">
                            <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                                <Icon name={step.icon} class="w-6 h-6 text-primary" />
                            </div>
                            <div class={`flex-1 min-w-0`}>
                                <Text size="sm" class="font-semibold text-foreground! uppercase tracking-wider mb-1">
                                    {t(currentLang, step.labelKey)}
                                </Text>
                                <Text size="sm" class="text-foreground/60! leading-relaxed mt-2">
                                    {t(currentLang, step.descKey)}
                                </Text>
                            </div>
                        </Card>
                    </div>

                    <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 z-10 w-10 h-10 rounded-full border-2 border-border bg-background items-center justify-center transition-all duration-500 group-[.active]:border-primary group-[.active]:bg-primary/10">
                        <Text size="sm">
                            {index + 1}
                        </Text>
                    </div>

                    <div class="flex-1 hidden md:block" />
                </div>
            );
        })}
    </div>
</Section>