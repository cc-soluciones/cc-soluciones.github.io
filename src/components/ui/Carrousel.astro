---
export interface Props {
    class?: string
    controls?: boolean
}

const { class: className = "", controls = true } = Astro.props
---

<div class={`embla ${className}`.trim()} data-embla>
    <div class="embla__viewport" data-embla-viewport>
        <div class="embla__container">
            <slot />
        </div>
    </div>

    {controls && (
        <div class="embla__controls">
            <button class="embla__btn" data-embla-prev type="button" aria-label="Previous">
                <svg class="embla__btn-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
            <div class="embla__dots" data-embla-dots></div>
            <button class="embla__btn" data-embla-next type="button" aria-label="Next">
                <svg class="embla__btn-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
        </div>
    )}
</div>

<style is:global>
    .embla {
        --slide-size: 100%;
        --slide-spacing: 1.5rem;
        position: relative;
    }

    @media (min-width: 640px) {
        .embla { --slide-size: 50%; }
    }

    @media (min-width: 1024px) {
        .embla { --slide-size: 33.3333%; }
    }

    .embla__viewport {
        overflow: hidden;
    }

    .embla__container {
        display: flex;
        touch-action: pan-y pinch-zoom;
        margin-left: calc(var(--slide-spacing) * -1);
    }

    .embla__slide {
        flex: 0 0 var(--slide-size);
        min-width: 0;
        padding-left: var(--slide-spacing);
    }

    .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .embla__btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        border: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
        backdrop-filter: blur(12px);
        color: var(--color-foreground);
        cursor: pointer;
        transition: background 0.2s;
    }

    .embla__btn:hover {
        background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
    }

    .embla__btn:disabled {
        opacity: 0.3;
        cursor: default;
    }

    .embla__btn-icon {
        width: 1.25rem;
        height: 1.25rem;
    }

    .embla__dots {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .embla__dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 9999px;
        border: none;
        background: color-mix(in srgb, var(--color-foreground) 25%, transparent);
        cursor: pointer;
        padding: 0;
        transition: background 0.2s, width 0.2s;
    }

    .embla__dot--active {
        background: var(--color-primary);
        width: 1.5rem;
        border-radius: 9999px;
    }
</style>

<script>
import EmblaCarousel from "embla-carousel";

const viewport = document.querySelector<HTMLDivElement>("[data-embla-viewport]");
if (viewport) {
    const embla = EmblaCarousel(viewport, { align: "start", loop: false, dragFree: false });
    const prevBtn = document.querySelector<HTMLButtonElement>("[data-embla-prev]");
    const nextBtn = document.querySelector<HTMLButtonElement>("[data-embla-next]");
    const dots = document.querySelector<HTMLDivElement>("[data-embla-dots]");

    function update() {
        const idx = embla.selectedScrollSnap();
        const snaps = embla.scrollSnapList();

        if (prevBtn) prevBtn.disabled = idx === 0;
        if (nextBtn) nextBtn.disabled = idx === snaps.length - 1;

        if (dots) {
            dots.innerHTML = "";
            snaps.forEach((_, i) => {
                const btn = document.createElement("button");
                btn.className = "embla__dot" + (i === idx ? " embla__dot--active" : "");
                btn.type = "button";
                btn.setAttribute("aria-label", `Go to slide ${i + 1}`);
                btn.addEventListener("click", () => embla.scrollTo(i));
                dots.appendChild(btn);
            });
        }
    }

    prevBtn?.addEventListener("click", () => embla.scrollPrev());
    nextBtn?.addEventListener("click", () => embla.scrollNext());

    embla.on("select", update);
    embla.on("reInit", update);
    update();
}
</script>
